<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="keywords" content="{$keywords}" />
<meta name="description" content="{$description}" />
<meta name="generator" content="{$generator}" />
<meta name="csrf-token" content="{$csrf_token}">
<title>{$page_title}</title>
<link href="{$site.root_url}favicon.ico" rel="shortcut icon" type="image/x-icon" />
<link href="css/bootstrap.min.css" rel="stylesheet" type="text/css" />
<link href="css/bootstrap-icons.css" rel="stylesheet" type="text/css" />
<link href="css/style.css" rel="stylesheet" type="text/css" />
<link href="css/brand.css" rel="stylesheet" type="text/css" />
{include file="inc/code_head.tpl"}
</head>
<body>
<div id="wrapper"> {include file="inc/header.tpl"}
 <div id="brand" class="container mb">
  <!-- {if $rec eq 'default'} 列表 -->
  <div class="row brand-list"> 
   <!-- {foreach from=$brand_list item=brand} --> 
   <div class="col-md-3 col-6">
    <div class="item">
     <div class="img scale"><a href="{$brand.url}"><img src="{$brand.image}" alt="{$brand.name}" /></a></div>
     <div class="name"><a href="{$brand.url}" title="{$brand.name}">{$brand.name}</a> <a class="btn-product" href="{$brand.product_list}" >{$lang.brand_product}</a></div>
    </div>
   </div>
   <!-- {/foreach} --> 
  </div>
  {include file="inc/pager.tpl"} 
  <!-- {/if} --> 
  <!-- {if $rec eq 'detail'} 详情 -->
  <div class="detail">
   <h1>{$brand.name}</h1>
   <div class="image"><img src="{$brand.image}" alt="{$brand.name}" /></div>
   <div class="action"><a class="btn-product" href="{$brand.product_list}" >{$lang.brand_product}</a></div>
   <div class="content">
    {$brand.content nofilter}
   </div>
  </div>
  <!-- {/if} --> 
 </div>
 {include file="inc/online_service.tpl"}
 {include file="inc/footer.tpl"} </div>
{include file="inc/code_footer.tpl"}
<script type="text/javascript" src="js/bootstrap.min.js"></script>
<script type="text/javascript" src="js/dou.js"></script>
</body>
</html>