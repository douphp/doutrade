<!DOCTYPE html>
<html lang="zh-CN">

<head>
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width, initial-scale=1">
 <meta name="keywords" content="{$keywords}" />
 <meta name="description" content="{$description}" />
 <meta name="generator" content="{$generator}" />
 <meta name="csrf-token" content="{$csrf_token}">
 <title>{$page_title}</title>
 <link href="{$site.root_url}favicon.ico" rel="shortcut icon" type="image/x-icon" />
 <link href="css/bootstrap.min.css" rel="stylesheet" type="text/css" />
 <link href="css/swiper.min.css" rel="stylesheet" type="text/css" />
 <link href="css/bootstrap-icons.css" rel="stylesheet" type="text/css" />
 <link href="css/common.css" rel="stylesheet" type="text/css" />
 <link href="css/style.css" rel="stylesheet" type="text/css" />
 <link href="css/product.css" rel="stylesheet" type="text/css" />
 {include file="inc/code_head.tpl"}
</head>

<body>
 <div id="wrapper"> {include file="inc/header.tpl"}
  <div class="container mb">
   <!-- {if $rec eq 'default'} 列表 -->
   <div id="product-category"> {include file="inc/ur_here.tpl"}
    <div class="row product-list">
     <!-- {foreach from=$product_list name=product_list item=product} -->
     <div class="col-md-2 col-6">
      <div class="item">
       <div class="img scale"><a href="{$product.url}"><img src="{$product.thumb}" /></a></div>
       <div class="name"><a href="{$product.url}">{$product.name}</a></div>
       <div class="price">{$lang.product_point}：<em>{$product.point}</em></div>
      </div>
     </div>
     <!-- {/foreach} -->
    </div>
    {include file="inc/pager.tpl"}
   </div>
   <!-- {/if} -->
   <!-- {if $rec eq 'detail'} 详情 -->
   <div id="product">
    <div class="product-img-info">
     <div class="product-img">
      <div class="gallery-top jqzoom">
       <img class="popup-img" src="{$product.image}" data-zoom-image="{$product.image}" />
      </div>
      <div class="gallery-thumbs">
       <ul class="thumb-list">
        <li class="thumb-item active"><img src="{$product.image}" /></li>
        <!-- {foreach from=$product.gallery_list name=gallery item=gallery} -->
        <li class="thumb-item"><img src="{$gallery.file}" /></li>
        <!-- {/foreach} -->
       </ul>
      </div>
      <!-- {if $product.favorites} -->
      <span class="btn-favorites{$product.favorites.class}" data-item_id="{$product.id}"><i class="bi bi-heart"></i><em>{$product.favorites.text}</em></span>
      <!-- {/if} -->
     </div>
     <div class="product-info">
      <h1>{$product.name}</h1>
      <ul>
       <li class="product-price">{$lang.price}：<em>{$product.price}</em></li>
       <li class="product-price">{$lang.product_point}：<em class="price">{$product.point}</em></li>
       <!-- {foreach from=$defined name=defined item=defined} -->
       <li>{$defined.arr}：{$defined.value}</li>
       <!-- {/foreach} -->
      </ul>
      <!-- {if $features.order} -->
      <div class="btn-buy">
       <form action="{url link='order.cart.store'}" method="post">
        <input type="hidden" name="module" value="product" />
        <input type="hidden" name="item_id" value="{$product.id}" />
        <input type="hidden" name="number" value="1" />
        <input type="hidden" name="mode" value="point" />
        <input type="hidden" name="token" value="{$token}" />
        <input type="submit" name="submit" class="btn" value="{$lang.point_addtocart}" />
       </form>
      </div>
      <!-- {else} -->
      <div class="btn-ask">
       <!-- {if $site.qq.0.number} -->
       <a href="http://wpa.qq.com/msgrd?v=3&amp;uin={$site.qq.0.number}&amp;site=qq&amp;menu=yes" target="_blank"><i class="bi bi-qq"></i>{$lang.online_qq}</a>
       <!-- {/if} -->
      </div>
      <!-- {/if} -->
     </div>
    </div>
    <div class="product-content">
     <h3>{$lang.product_content}</h3>
     <ul>
      {$product.content nofilter}
     </ul>
    </div>
   </div>
   <!-- {/if} -->
  </div>
  {include file="inc/online_service.tpl"}
  {include file="inc/footer.tpl"}
 </div>
 {include file="inc/code_footer.tpl"}
 <script type="text/javascript" src="js/bootstrap.min.js"></script>
 <script type="text/javascript" src="js/swiper.min.js"></script>
 <script type="text/javascript" src="js/product.js"></script>
 <script type="text/javascript" src="js/dou.js"></script>
 <script type="text/javascript" src="js/online_service.js"></script>
</body>

</html>