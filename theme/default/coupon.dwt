<!DOCTYPE html>
<html lang="{$site.language.tag}">

<head>
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width, initial-scale=1">
 <meta name="keywords" content="{$keywords}" />
 <meta name="description" content="{$description}" />
 <meta name="generator" content="{$generator}" />
 <meta name="csrf-token" content="{$csrf_token}">
 <title>{$page_title}</title>
 <link href="{$site.root_url}favicon.ico" rel="shortcut icon" type="image/x-icon" />
 <link href="css/bootstrap-icons.css" rel="stylesheet" type="text/css" />
 <link href="css/common.css" rel="stylesheet" type="text/css" />
 <link href="css/user.css" rel="stylesheet" type="text/css" />
 <link href="css/coupon.css" rel="stylesheet" type="text/css" />
 {include file="inc/code_head.tpl"}
</head>

<body>
 <div id="wrapper">
  {include file="inc/common_header.tpl"}
  <div class="container mb">
   <div id="user">
    <div class="userLeft"> {include file="inc/user_tree.tpl"} </div>
    <div class="userIn">
     <div class="main">
      <!-- {if $rec eq 'user'} 优惠券记录 -->
      <h3>{$lang.coupon_log} <a class="coupon-center-link" href="{url link='coupon'}">{$lang.coupon_buy}</a></h3>
      <div class="coupon-list">
       <!-- {foreach from=$coupon_list item=item} -->
       <div class="item-box">
        <div class="item{if $item.status.value neq 'got'} gray{/if}">
         <div class="head">
          <div class="circle"></div>
          <div class="money">{$item.money}</div>
          <div class="name">{$item.name}</div>
          <div class="time">{$item.start_at}~{$item.end_at}</div>
         </div>
         <div class="body">
          <div class="row"><b>{$lang.coupon_coupon_sn} :</b> {$item.coupon_sn}{if $item.status.value neq 'got'} <i>({$item.status.format})</i>{/if}</div>
          <div class="row"><b>{$lang.coupon_brief} :</b> {$item.brief}</div>
         </div>
        </div>
       </div>
       <!-- {/foreach} -->
      </div>
      <!-- {if !$coupon_list} -->
      <div class="empty-list">{$lang.coupon_log}{$lang.empty_list}</div>
      <!-- {/if} -->
      {include file="inc/pager.tpl"}
      <!-- {/if} -->
     </div>
    </div>
    <!-- /userIn -->
   </div>
  </div>
  {include file="inc/common_footer.tpl"}
 </div>
 {include file="inc/code_footer.tpl"}
 <script type="text/javascript" src="js/dou.js"></script>
 <script type="text/javascript" src="js/online_service.js"></script>
 <script type="text/javascript" src="js/input.js"></script>
 <!-- {if $rec eq 'edit' && $site.language.pack eq 'en_us'} -->
 <script type="text/javascript" src="js/city.world.js"></script>
 <!-- {/if} -->
</body>

</html>