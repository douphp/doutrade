<!DOCTYPE html>
<html lang="{$site.language.tag}">

<head>
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width, initial-scale=1">
 <meta name="keywords" content="{$keywords}" />
 <meta name="description" content="{$description}" />
 <meta name="generator" content="{$generator}" />
 <meta name="csrf-token" content="{$csrf_token}">
 <title>{$page_title}</title>
 <link href="{$site.root_url}favicon.ico" rel="shortcut icon" type="image/x-icon" />
 <link href="css/bootstrap-icons.css" rel="stylesheet" type="text/css" />
 <link href="css/common.css" rel="stylesheet" type="text/css" />
 <link href="css/user.css" rel="stylesheet" type="text/css" />
 <link href="css/comment.css" rel="stylesheet" type="text/css" />
 {include file="inc/code_head.tpl"}
</head>

<body>
 <div id="wrapper">
  {include file="inc/common_header.tpl"}
  <div class="container mb">
   <div id="user">
    <div class="userLeft"> {include file="inc/user_tree.tpl"} </div>
    <div class="userIn">
     <div class="main">
      <div id="comment">
       <!-- {if $rec eq 'user'} 评论.会员中心 -->
       <h3>{$lang.comment_list}</h3>
       <div class="comment-list bor">
        <!-- {foreach from=$comment_list item=comment} -->
        <dl>
         <dt><span>{$comment.nickname} {$comment.created_at}</span><a href="{$comment.item_url}" target="_blank">{$lang.comment_item} {$comment.item_name}</a></dt>
         <dd class="content">
          <div class="comment-star">
           <!-- {foreach from=$comment.star_box.list item=item} -->
           <i class="bi bi-star active"></i>
           <!-- {/foreach} -->
           <i class="star-number">{$comment.star_box.number}</i>
          </div>
          <p>{$comment.content nofilter}</p>
          <!-- {foreach from=$comment.img_list item=item} -->
          <a href="{$item.file}" target="_blank"><img src="{$item.file}" height="80" /></a>
          <!-- {/foreach} -->
         </dd>
         <!-- {if $comment.reply} -->
         <dd class="reply">
          <p class="replyContent">{$lang.comment_reply}：{$comment.reply.content nofilter}</p>
          <p class="replyTime">{$comment.reply.created_at}</p>
         </dd>
         <!-- {/if} -->
        </dl>
        <!-- {/foreach} -->
        {include file="inc/pager.tpl"}
       </div>
       <!-- {/if} -->
       <!-- {if $rec eq 'post'} 评论.发布 -->
       <h3>{$lang.comment_post}</h3>
       <div class="post">
        <form id="commentPost" x-data="douForm()" @submit.prevent="submit" action="{url link='comment.user.store'}" method="post" enctype="multipart/form-data">
         {include file="inc/honeypot.tpl"}
         <div class="form">
          <div class="form-item">
           <div class="form-label">{$lang.order_sn}：</div>
           <div class="input-block"><a href="{$item.order.order_link}" style="margin-right: 30px">{$item.order.order_sn}</a> {$item.order.created_at}</div>
          </div>
          <div class="form-item">
           <div class="form-label">{$lang.comment_item_id}：</div>
           <div class="input-block order-item">
            <a href="{$item.product.url}" target="_blank">
             <!-- {if $item.product.image} -->
             <i class="img"><img src="{$item.product.image}" /></i>
             <!-- {/if} -->
             <em class="name">{$item.product.name}</em>
            </a>
           </div>
          </div>
          <div class="form-item">
           <div class="form-label">{$lang.comment_content}：</div>
           <div class="input-block">
            <textarea name="content" cols="90" rows="5" class="textarea" maxlength="300" /></textarea>
            <p class="cue" x-show="hasError('content')" x-text="errorOf('content')"></p>
           </div>
          </div>
          <div class="form-item">
           <div class="form-label">{$lang.comment_star}：</div>
           <div class="input-block">
            <div class="comment-star big star-box" data-star-unit="{$lang.comment_star_unit}">
             <i class="bi bi-star active"></i>
             <i class="bi bi-star active"></i>
             <i class="bi bi-star active"></i>
             <i class="bi bi-star active"></i>
             <i class="bi bi-star active"></i>
             <i class="star-number">5{$lang.comment_star_unit}</i>
            </div>
            <input id="starValue" type="hidden" name="star" value="5" />
            <p class="cue" x-show="hasError('star')" x-text="errorOf('star')"></p>
           </div>
          </div>
          <div class="form-item">
           <div class="form-label">{$lang.comment_image}</div>
           <div class="input-block">
            {include file="inc/file_gallery.tpl" module="comment" prefix="gallery" item_id=$order_item_id draft_token="" list_html=$img_list_html}
            <p class="cueGray" style="margin-top: 5px">{$lang.comment_image_cue}</p>
           </div>
          </div>
          <div class="form-item submit">
           <div class="input-block">
            <input type="hidden" name="order_item_id" value="{$order_item_id}">
            <input type="hidden" name="module" value="{$item.module}">
            <input type="hidden" name="item_id" value="{$item.item_id}">
            <input type="hidden" name="token" value="{$token}" />
            <button class="btn" type="submit" :disabled="loading">{$lang.btn_submit}</button>
            <div class="anonymous">
             <label><input type="checkbox" name="anonymous" value="1" />
              <b>{$lang.comment_anonymous_post}</b></label>
            </div>
            <p class="cue" x-show="message" x-text="message"></p>
           </div>
          </div>
         </div>
        </form>
       </div>
       <!-- {/if} -->
      </div>
     </div>
    </div>
    <!-- /userIn -->
   </div>
  </div>
  {include file="inc/common_footer.tpl"}
 </div>
 {include file="inc/code_footer.tpl"}
 <script type="text/javascript" src="js/jquery.form.min.js"></script>
 <script type="text/javascript" src="js/alpine.min.js" defer></script>
 <script type="text/javascript" src="js/dou.js"></script>
 <script type="text/javascript" src="js/dou.form.js"></script>
 <script type="text/javascript" src="js/online_service.js"></script>
 <script type="text/javascript" src="js/file.js"></script>
 <script type="text/javascript" src="js/star.js"></script>
</body>

</html>