<!DOCTYPE html>
<html lang="{$site.language.tag}">

<head>
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width, initial-scale=1">
 <meta name="keywords" content="{$keywords}" />
 <meta name="description" content="{$description}" />
 <meta name="generator" content="{$generator}" />
 <meta name="csrf-token" content="{$csrf_token}">
 <title>{$page_title}</title>
 <link href="{$site.root_url}favicon.ico" rel="shortcut icon" type="image/x-icon" />
 <link href="css/bootstrap-icons.css" rel="stylesheet" type="text/css" />
 <link href="css/common.css" rel="stylesheet" type="text/css" />
 <link href="css/user.css" rel="stylesheet" type="text/css" />
 {include file="inc/code_head.tpl"}
</head>

<body>
 <div id="wrapper">
  {include file="inc/common_header.tpl"}
  <div class="container mb">
   <div id="user">
    <div class="passport">
     <!-- {if $rec eq 'register'} 会员注册 -->
     <div class="register">
      <h3>{$lang.user_register}<em>{$user_register_cue_0}{$site.site_name}{$lang.user_register_cue_1} <a href="{url link='user.login'}">{$lang.user_register_login}</a></em></h3>
      <form id="register" x-data="douForm()" @submit.prevent="submit" action="{url link='user.register_post'}" method="post">
       {include file="inc/honeypot.tpl"}
       <div class="form">
        <!-- {if $param.login_mode eq 'mobile'} -->
        <div class="form-item">
         <div class="form-label">{$lang.user_mobile}<i>*</i></div>
         <div class="input-block">
          <input name="mobile" id="shouji" type="text" class="input" value="{$post.mobile}" size="36" />
          <p class="cue" x-show="hasError('mobile')" x-text="errorOf('mobile')"></p>
         </div>
        </div>
        {if $param.sms_accessKeyId}
        <div class="form-item">
         <div class="input-block">
          <input type="text" name="verification" class="input" placeholder="{$lang.please_input}{$lang.captcha}" autocomplete="off" />
          <input type="button" value="{$lang.verification_get}" id="btnCaptcha" class="btn-captcha" onclick="sendCaptcha('sms', 'shouji', '{$captcha_token}')">
          <i>*</i>
          <p class="cue" x-show="hasError('verification')" x-text="errorOf('verification')"></p>
         </div>
        </div>
        {/if}
        <!-- {else} -->
        <div class="form-item">
         <div class="form-label">{$lang.user_email}<i>*</i></div>
         <div class="input-block">
          <input name="email" id="youxiang" type="text" class="input" value="{$post.email}" size="36" />
          <p class="cue" x-show="hasError('email')" x-text="errorOf('email')"></p>
         </div>
        </div>
        {if $site.mail_username}
        <div class="form-item">
         <div class="input-block">
          <input type="text" name="verification" class="input" placeholder="{$lang.please_input}{$lang.captcha}" autocomplete="off" />
          <input type="button" value="{$lang.verification_get}" id="btnCaptcha" class="btn-captcha" onclick="sendCaptcha('email', 'youxiang', '{$captcha_token}')">
          <i>*</i>
          <p class="cue" x-show="hasError('verification')" x-text="errorOf('verification')"></p>
         </div>
        </div>
        {/if}
        <!-- {/if} -->
        <div class="form-item">
         <div class="form-label">{$lang.user_password}<i>*</i></div>
         <div class="input-block">
          <input name="password" type="password" class="input" size="36" />
          <p class="cue" x-show="hasError('password')" x-text="errorOf('password')"></p>
         </div>
        </div>
        <div class="form-item">
         <div class="form-label">{$lang.user_password_confirm}<i>*</i></div>
         <div class="input-block">
          <input name="password_confirm" type="password" class="input" size="36" />
          <p class="cue" x-show="hasError('password_confirm')" x-text="errorOf('password_confirm')"></p>
         </div>
        </div>
        <div class="form-item">
         <div class="input-block">
          <div class="agree">
           <label>
            <input name="confirm" type="checkbox" onclick="agree();" align="absMiddle" id="agreement" />
            <span>{$lang.agreement_read} <a href="{url link='page.detail' slug='agreement'}">{$lang.agreement}</a></span></label>
          </div>
         </div>
        </div>
        <div class="form-item submit">
         <div class="input-block">
          <input type="hidden" name="token" value="{$token}" />
          <input type="hidden" name="sns_token" value="{$sns_token}" />
          <button type="submit" id="submitBtn" class="btn-secondary" disabled="disabled">{$lang.user_register_btn}</button>
          <p class="cue" x-show="message" x-text="message"></p>
         </div>
        </div>
       </div>
      </form>
     </div>
     <!-- {/if} -->
     <!-- {if $rec eq 'login'} 会员登录 -->
     <div class="login">
      <h3>{$lang.user_login}<em>{$lang.user_login_cue}</em></h3>
      <form id="login" x-data="douForm()" @submit.prevent="submit" action="{url link='user.login_post'}" method="post">
       {include file="inc/honeypot.tpl"}
       <!-- {if $param.login_mode neq 'weixin'} -->
       <div class="form">
        <div class="form-item">
         <div class="form-label">{$lang.user_username}</div>
         <div class="input-block">
          <input type="text" name="username" class="input" />
          <p class="cue" x-show="hasError('username')" x-text="errorOf('username')"></p>
         </div>
        </div>
        <div class="form-item">
         <div class="form-label">{$lang.user_password}</div>
         <div class="input-block">
          <input type="password" name="password" class="input" />
          <p class="cue" x-show="hasError('password')" x-text="errorOf('password')"></p>
         </div>
        </div>
        <!-- {if $site.captcha} -->
        <div class="form-item">
         <div class="input-block">
          <input name="captcha" type="text" class="textarea captcha" size="10">
          <img id="vcode" src="{url link='captcha'}" alt="{$lang.captcha}" border="1" onClick="refreshimage()" title="{$lang.captcha_refresh}">
          <p class="cue" x-show="hasError('captcha')" x-text="errorOf('captcha')"></p>
         </div>
        </div>
        <!-- {/if} -->
        <div class="form-item">
         <div class="input-block">
          <label>
           <input name="remember" type="checkbox" />
           <span>{$lang.user_login_remember}</span></label>
         </div>
        </div>
        <div class="form-item submit">
         <div class="input-block">
          <input type="hidden" name="token" value="{$token}" />
          <input type="hidden" name="sns_token" value="{$sns_token}" />
          <input type="hidden" name="return_url" value="{$return_url}" />
          <button type="submit" class="btn" :disabled="loading">{$lang.user_login_btn}</button>
          <p class="cue" x-show="message" x-text="message"></p>
         </div>
        </div>
        <div class="form-item">
         <div class="input-block">
          <a href="{$login_phone_url}" style="float: right ">{$lang.user_login_phone}</a><a href="{url link='user.password_reset'}">{$lang.user_password_reset}？</a>
         </div>
        </div>
        <div class="form-item">
         <div class="input-block">
          <a href="{url link='user.register'}" class="btnRegister">{$lang.user_register}</a>
         </div>
        </div>
       </div>
       <div class="snsIcon">
        <!-- {foreach from=$connect_plugin_list item=plugin} -->
        <!-- {if $plugin.code} -->
        {$plugin.code}
        <!-- {else} -->
        <a href="{$plugin.url}" title="{$plugin.name}" style="background: #19B4EA url({$plugin.icon}) no-repeat 50% 50%;"></a>
        <!-- {/if} -->
        <!-- {/foreach} -->
       </div>
       <!-- {else} -->
       <div class="wxlogin">
        <!-- {foreach from=$connect_plugin_list item=plugin} -->
        <!-- {if $plugin.slug eq 'wxlogin'} -->
        <a href="{$plugin.url}" title="{$plugin.name}">
         <p class="bi bi-wechat"></p>
         <p class="name">{$plugin.name}</p>
        </a>
        <!-- {/if} -->
        <!-- {/foreach} -->
       </div>
       <!-- {/if} -->
      </form>
     </div>
     <!-- {/if} -->
     <!-- {if $rec eq 'login_phone'} 手机号登录 -->
     <div class="login">
      <h3>{$lang.user_login_phone}</h3>
      <form id="loginPhone" x-data="douForm()" @submit.prevent="submit" action="{url link='user.login_phone_post'}" method="post">
       <div class="form">
        <div class="form-item">
         <div class="form-label">{$lang.user_mobile}</div>
         <div class="input-block">
          <input name="mobile" id="shouji" type="text" class="input" value="{$post.mobile}" size="36" />
          <p class="cue" x-show="hasError('mobile')" x-text="errorOf('mobile')"></p>
         </div>
        </div>
        <div class="form-item">
         <div class="input-block">
          <input type="text" name="verification" class="input captcha" placeholder="{$lang.please_input}{$lang.captcha}" autocomplete="off" style="width: 150px" />
          <input type="button" value="{$lang.verification_get}" id="btnCaptcha" class="btn-captcha" onclick="sendCaptcha('sms', 'shouji', '{$captcha_token}', 'allow_phone_exist')">
          <p class="cue" x-show="hasError('verification')" x-text="errorOf('verification')"></p>
         </div>
        </div>
        <div class="form-item">
         <div class="input-block">
          <label>
           <input name="remember" type="checkbox" />
           <span>{$lang.user_login_remember}</span></label>
         </div>
        </div>
        <div class="form-item submit">
         <div class="input-block">
          <input type="hidden" name="token" value="{$token}" />
          <input type="hidden" name="return_url" value="{$return_url}" />
          <button type="submit" class="btn" :disabled="loading">{$lang.user_login_phone_btn}</button>
          <p class="cue" x-show="message" x-text="message"></p>
         </div>
        </div>
       </div>
      </form>
     </div>
     <!-- {/if} -->
     <!-- {if $rec eq 'password_reset'} 重置密码 -->
     <div class="action-box">
      <!-- {if $act eq 'default'} -->
      <h3>{$lang.user_password_reset}<em>{$lang.user_password_reset_cue}</em></h3>
      <form action="{url link='user.password_reset_post'}" method="post">
       {include file="inc/honeypot.tpl"}
       <div class="form">
        <div class="form-item">
         <div class="input-block">
          <input type="text" name="username" class="input" autocomplete="off" placeholder="{$lang.user_username}" />
         </div>
        </div>
        <!-- {if $site.captcha} -->
        <div class="form-item">
         <div class="input-block">
          <input name="captcha" type="text" class="textarea captcha" size="10">
          <img id="vcode" src="{url link='captcha'}" alt="{$lang.captcha}" border="1" onClick="refreshimage()" title="{$lang.captcha_refresh}">
         </div>
        </div>
        <!-- {/if} -->
        <div class="form-item submit">
         <div class="input-block">
          <input type="hidden" name="token" value="{$token}" />
          <input type="submit" name="submit" class="btn" value="{$lang.user_password_reset_btn_check}" />
         </div>
        </div>
       </div>
      </form>
      <!-- {elseif $act eq 'check'} -->
      <h3>{$lang.user_password_reset_check}<em>{$user_password_reset_check_cue}</em></h3>
      <div class="type">
       <a{if $type.value eq 'sms' } class="active" {/if} href="{$type.sms}">{$lang.verification_sms}</a>
        <!-- {if $user_info.email} -->
        <a{if $type.value eq 'email' } class="active" {/if} href="{$type.email}">{$lang.verification_email}</a>
         <!-- {/if} -->
      </div>
      <form action="{url link='user.password_reset_post'}" method="post">
       <div class="form">
        <!-- {if $type.value eq 'sms'} -->
        <div class="form-item account">{$lang.user_mobile}：{$user_info.mobile}</div>
        <div class="form-item">
         <div class="form-label">{$lang.captcha}</div>
         <div class="input-block">
          <input id="shouji" type="hidden" value="{$user_info.mobile}" />
          <input type="text" name="verification" class="input" style="width: 205px;" placeholder="{$lang.please_input}{$lang.captcha}" autocomplete="off" />
          <input type="button" value="{$lang.verification_get}" id="btnCaptcha" class="btn-captcha" onclick="sendCaptcha('sms', 'shouji', '{$captcha_token}', 'allow_phone_exist')">
          <p id="verification" class="cue"></p>
         </div>
        </div>
        <!-- {else} -->
        <div class="form-item account">{$lang.user_email}：{$user_info.email}</div>
        <div class="form-item">
         <div class="form-label">{$lang.captcha}</div>
         <div class="input-block">
          <input id="youxiang" type="hidden" value="{$user_info.email}" />
          <input type="text" name="verification" class="input" style="width: 205px;" placeholder="{$lang.please_input}{$lang.captcha}" autocomplete="off" />
          <input type="button" value="{$lang.verification_get}" id="btnCaptcha" class="btn-captcha" onclick="sendCaptcha('email', 'youxiang', '{$captcha_token}', 'allow_phone_exist')">
          <p id="verification" class="cue"></p>
         </div>
        </div>
        <!-- {/if} -->
        <div class="form-item submit">
         <div class="input-block">
          <input type="hidden" name="act" value="check" />
          <input type="hidden" name="type" value="{$type.value}" />
          <input type="hidden" name="token" value="{$token}" />
          <input type="submit" name="submit" class="btn" value="{$lang.btn_submit}" />
         </div>
        </div>
       </div>
      </form>
      <!-- {elseif $act eq 'password'} -->
      <h3>{$lang.user_password_reset_password}</h3>
      <form action="{url link='user.password_reset_post'}" method="post">
       <div class="form">
        <div class="form-item">
         <div class="form-label">{$lang.user_password_new}</div>
         <div class="input-block">
          <input name="password" type="password" class="input" size="36" />
         </div>
        </div>
        <div class="form-item">
         <div class="form-label">{$lang.user_password_new_confirm}</div>
         <div class="input-block">
          <input name="password_confirm" type="password" class="input" size="36" />
         </div>
        </div>
        <div class="form-item submit">
         <div class="input-block">
          <input type="hidden" name="act" value="password" />
          <input type="hidden" name="token" value="{$token}" />
          <input type="submit" name="submit" class="btn" value="{$lang.btn_submit}" />
         </div>
        </div>
       </div>
      </form>
      <!-- {/if} -->
     </div>
     <!-- {/if} /重置密码 -->
     <!-- {if $rec eq 'verification'} 身份验证 -->
     <div class="action-box">
      <h3>{$lang.verification_check}<em>{$verification_check_cue}</em></h3>
      <div class="type">
       <!-- {if $user_info.mobile} -->
       <a{if $ver.value eq 'sms' } class="active" {/if} href="{$ver.sms}">{$lang.verification_sms}</a>
        <!-- {/if} -->
        <!-- {if $user_info.email} -->
        <a{if $ver.value eq 'email' } class="active" {/if} href="{$ver.email}">{$lang.verification_email}</a>
         <!-- {/if} -->
      </div>
      <form action="{url link='user.verify.verification_post'}" method="post">
       <div class="form">
        <!-- {if $ver.value eq 'sms'} -->
        <div class="form-item account">{$lang.user_mobile}：{$user_info.mobile}</div>
        <div class="form-item">
         <div class="form-label">{$lang.captcha}</div>
         <div class="input-block">
          <input id="shouji" type="hidden" value="{$user_info.mobile}" />
          <input type="text" name="verification" class="input" style="width: 205px;" placeholder="{$lang.please_input}{$lang.captcha}" autocomplete="off" />
          <input type="button" value="{$lang.verification_get}" id="btnCaptcha" class="btn-captcha" onclick="sendCaptcha('sms', 'shouji', '{$captcha_token}', 'allow_phone_exist')">
          <p id="verification" class="cue"></p>
         </div>
        </div>
        <!-- {else} -->
        <div class="form-item account">{$lang.user_email}：{$user_info.email}</div>
        <div class="form-item">
         <div class="form-label">{$lang.captcha}</div>
         <div class="input-block">
          <input id="youxiang" type="hidden" value="{$user_info.email}" />
          <input type="text" name="verification" class="input" style="width: 205px;" placeholder="{$lang.please_input}{$lang.captcha}" autocomplete="off" />
          <input type="button" value="{$lang.verification_get}" id="btnCaptcha" class="btn-captcha" onclick="sendCaptcha('email', 'youxiang', '{$captcha_token}', 'allow_phone_exist')">
          <p id="verification" class="cue"></p>
         </div>
        </div>
        <!-- {/if} -->
        <div class="form-item submit">
         <div class="input-block">
          <input type="hidden" name="act" value="check" />
          <input type="hidden" name="type" value="{$ver.value}" />
          <input type="hidden" name="token" value="{$token}" />
          <input type="submit" name="submit" class="btn" value="{$lang.btn_submit}" />
         </div>
        </div>
       </div>
      </form>
     </div>
     <!-- {/if} /身份验证 -->
     <!-- {if $rec eq 'mobile'} 手机号修改 -->
     <div class="action-box">
      <h3>{$lang.user_modify_mobile}</h3>
      <form action="{url link='user.verify.mobile_post'}" method="post">
       <div class="form">
        <div class="form-item">
         <div class="form-label">{$lang.user_mobile_new}：</div>
         <div class="input-block">
          <input id="shouji" name="mobile" type="text" class="input" value="{$post.mobile}" size="36" />
          <p id="mobile" class="cue"></p>
         </div>
        </div>
        <div class="form-item">
         <div class="input-block">
          <input type="text" name="verification" class="input" placeholder="{$lang.please_input}{$lang.captcha}" autocomplete="off" />
          <input type="button" value="{$lang.verification_get}" id="btnCaptcha" class="btn-captcha" onclick="sendCaptcha('sms', 'shouji', '{$captcha_token}')">
          <p id="verification" class="cue"></p>
         </div>
        </div>
        <div class="form-item submit">
         <div class="input-block">
          <input type="hidden" name="act" value="check" />
          <input type="hidden" name="type" value="{$ver.value}" />
          <input type="hidden" name="token" value="{$token}" />
          <input type="submit" name="submit" class="btn" value="{$lang.btn_submit}" />
         </div>
        </div>
       </div>
      </form>
     </div>
     <!-- {/if} -->
     <!-- {if $rec eq 'email'} 邮箱修改 -->
     <div class="action-box">
      <h3>{$lang.user_modify_email}</h3>
      <form action="{url link='user.verify.email_post'}" method="post">
       <div class="form">
        <div class="form-item">
         <div class="form-label">{$lang.user_email_new}：</div>
         <div class="input-block">
          <input id="youxiang" name="email" type="text" class="input" value="{$post.email}" size="36" />
          <p id="email" class="cue"></p>
         </div>
        </div>
        <div class="form-item">
         <div class="input-block">
          <input type="text" name="verification" class="input" placeholder="{$lang.please_input}{$lang.captcha}" autocomplete="off" />
          <input type="button" value="{$lang.verification_get}" id="btnCaptcha" class="btn-captcha" onclick="sendCaptcha('email', 'youxiang', '{$captcha_token}')">
          <p id="verification" class="cue"></p>
         </div>
        </div>
        <div class="form-item submit">
         <div class="input-block">
          <input type="hidden" name="act" value="check" />
          <input type="hidden" name="type" value="{$ver.value}" />
          <input type="hidden" name="token" value="{$token}" />
          <input type="submit" name="submit" class="btn" value="{$lang.btn_submit}" />
         </div>
        </div>
       </div>
      </form>
     </div>
     <!-- {/if} -->
     <!-- {if $rec eq 'password'} 密码修改 -->
     <div class="action-box">
      <h3>{$lang.user_password_edit}</h3>
      <form action="{url link='user.profile.password_post'}" method="post">
       <div class="form">
        <div class="form-item">
         <div class="form-label">{$lang.user_old_password}<i>*</i></div>
         <div class="input-block">
          <input name="old_password" type="password" class="input" size="40" />
         </div>
        </div>
        <div class="form-item">
         <div class="form-label">{$lang.user_password}<i>*</i></div>
         <div class="input-block">
          <input name="password" type="password" class="input" size="40" />
         </div>
        </div>
        <div class="form-item">
         <div class="form-label">{$lang.user_password_confirm}<i>*</i></div>
         <div class="input-block">
          <input name="password_confirm" type="password" class="input" size="40" />
         </div>
        </div>
        <div class="form-item submit">
         <div class="input-block">
          <input type="hidden" name="token" value="{$token}" />
          <input type="submit" name="submit" class="btn" value="{$lang.btn_submit}" />
         </div>
        </div>
       </div>
      </form>
     </div>
     <!-- {/if} -->
     <!-- {if $rec eq 'sns_link'} 账号绑定 -->
     <div class="snsLink">
      <div class="head">{$lang.user_sns}</div>
      <div class="img"><img src="{$sns.avatar}" /></div>
      <div>{$sns.nickname}</div>
      <div class="action">
       <a href="{$url_register}" class="btn">{$lang.user_sns_new_account}</a>
       <a href="{$url_login}" class="btn-secondary">{$lang.user_sns_old_account}</a>
      </div>
     </div>
     <!-- {/if} -->
    </div>
   </div>
  </div>
  {include file="inc/common_footer.tpl"}
 </div>
 {include file="inc/code_footer.tpl"}
 <script type="text/javascript" src="js/alpine.min.js" defer></script>
 <script type="text/javascript" src="js/dou.js"></script>
 <script type="text/javascript" src="js/dou.form.js"></script>
 <script type="text/javascript" src="js/online_service.js"></script>
 <script type="text/javascript" src="js/input.js"></script>
 <script type="text/javascript" src="js/captcha.js"></script>
</body>

</html>