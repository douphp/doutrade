.cart .cartEmpty {
 background-color: #FFFFFF;
 font-size: 14px;
 text-align: center;
 padding: 150px 50px;
}
.cart .cartBtn {
 background-color: #DDDDDD;
 width: 100%;
 min-width: 320px;
 margin: 0 auto;
 max-width: 640px;
 height: 40px;
 line-height: 40px;
 font-size: 13px;
}
.cart .cartBtn .em {
 float: left;
 margin-left: 10px;
 color: #e4393c;
}
.cart .cartBtn .checkout {
 background-color: #e4393c;
 float: right;
 width: 80px;
 color: #FFF;
 text-align: center;
}
.cart .cart-empty-go {
 margin: 0 auto 30px;
 width: 120px;
 height: 36px;
 line-height: 36px;
 text-align: center;
 font-size: 14px;
 color: #fff;
 background-color: #e4393c;
 border-radius: 18px;
}
.cart .cart-invalid {
 margin-top: 10px;
 background-color: #FFFFFF;
}
.cart .cart-invalid .h2 {
 padding: 10px;
 font-size: 14px;
 color: #333;
 border-bottom: 1px solid #f0f0f0;
}
.cart .cart-invalid .item {
 display: flex;
 align-items: center;
 padding: 10px;
 border-bottom: 1px solid #f5f5f5;
}
.cart .cart-invalid .img {
 width: 60px;
 height: 60px;
 margin-right: 10px;
 flex: none;
}
.cart .cart-invalid .img image {
 width: 100%;
 height: 100%;
}
.cart .cart-invalid .con {
 flex: 1;
 min-width: 0;
}
.cart .cart-invalid .name {
 font-size: 13px;
 color: #666;
 overflow: hidden;
 text-overflow: ellipsis;
 white-space: nowrap;
}
.cart .cart-invalid .reason {
 margin-top: 4px;
 font-size: 12px;
 color: #999;
}
.cart .cart-invalid .del {
 flex: none;
 padding-left: 10px;
 font-size: 12px;
 color: #999;
}
.cart .cart-invalid .clear {
 padding: 12px;
 text-align: center;
 font-size: 13px;
 color: #666;
}
.cart .stock-shortage {
 display: block;
 margin-top: 4px;
 font-size: 12px;
 color: #e4393c;
}
.cart .number .plus.disabled {
 color: #ccc;
}