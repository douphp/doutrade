<!--cart.wxml-->
<navbar title="{{title}}" showMenu="{{false}}"></navbar>
<view class="body">
 <view class='body miniH'>
  <view class="cart"> 
   <block wx:if="{{cart && cart.list.length}}">
    <view class="order-item-list cart-mode"> 
     <view class="item" wx:for="{{cart.list}}" wx:for-item="item" wx:key="index">
      <view class="box{{!item.image ? ' no-img' : ''}}" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" style="margin-left: -{{item.touch_move}}px;margin-right: {{item.touch_move}}px;" data-index="{{index}}">
       <view class="img" data-url="/pages/product/product?id={{item.item_id}}" bindtap="douNavigateTo" wx:if="{{item.image}}"><image src="{{item.image}}" /></view>
       <view class="con">
        <view class="name" data-url="/pages/product/product?id={{item.item_id}}" bindtap="douNavigateTo">{{item.name}}</view>
        <view class="info-number">
         <view class="info">
          <view class="att-box">
           <text class="att-name" wx:if="{{item.attribute_name}}">{{item.attribute_name}}</text>
          </view>
          <view class="price-box"><text class="price">{{item.sale_price.format}}</text><text class="price-cue" wx:if="{{item.sale_price.name}}">{{item.sale_price.name}}</text><text class="price-gray" wx:if="{{item.sale_price.type != 'original'}}">{{item.price}}</text></view>
          <text class="stock-shortage" wx:if="{{item.stock_shortage}}">{{lang.order_cart_stock_shortage}}{{item.max_number}}</text>
         </view>
         <view class="number-box" wx:if="{{item.module == 'product'}}">
          <view class="number">
           <text class="minus" data-id="{{item.id}}" data-action="minus" bindtap="changeNumber"> - </text>
           <input class="inp" type="number" value="{{item.number}}" data-id="{{item.id}}" bindblur="inputNumber" />
           <text class="plus{{item.number >= item.max_number ? ' disabled' : ''}}" data-id="{{item.id}}" data-action="plus" bindtap="changeNumber">+</text>
          </view>
         </view>
         <view class="number-box" wx:else>x {{item.number}}</view>
        </view>
       </view>
       <view data-id="{{item.id}}" bindtap="itemDel" class="del">{{lang.del || '删除'}}</view>
      </view>
     </view>
    </view>
   </block>

   <view class="cart-invalid" wx:if="{{cart && cart.invalid_list && cart.invalid_list.length}}">
    <view class="h2">{{lang.order_cart_invalid}}</view>
    <view class="item" wx:for="{{cart.invalid_list}}" wx:for-item="item" wx:key="index">
     <view class="img" wx:if="{{item.image}}"><image src="{{item.image}}" /></view>
     <view class="con">
      <view class="name">{{item.name || lang.order_item_off_shelf}}</view>
      <view class="reason">{{item.reason_text}} · x {{item.number}}</view>
     </view>
     <view class="del" data-id="{{item.id}}" bindtap="itemDel">{{lang.del || '删除'}}</view>
    </view>
    <view class="clear" bindtap="clearInvalid">{{lang.order_cart_clear_invalid}}</view>
   </view>

   <block wx:if="{{!cart || (!cart.list.length && (!cart.invalid_list || !cart.invalid_list.length))}}">
    <view class="cartEmpty">{{lang.order_cart_empty}}</view>
    <view class="cart-empty-go" data-url="/pages/index/index" bindtap="douSwitchTab">{{lang.order_cart_empty_go}}</view>
   </block>

   <view class="fixex" wx:if="{{cart && cart.list.length}}">
    <view class="cartBtn">
     <view class="em">{{lang.order_item_amount}}：{{cart.item_amount_format}}</view>
     <view class="checkout" data-url="/pages/order/checkout" bindtap="douNavigateTo">{{lang.order_checkout}}( {{cart.total}} )</view>
    </view>
   </view>
  </view>
 </view>
</view>
