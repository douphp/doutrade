<!--pages/user/edit.wxml-->
<navbar title="{{title}}"></navbar>
<view class="body">
 <view class="wrap">
  <view class="form-basic form-padding">
   <form bindsubmit="userEdit">
    <view class="dl">
     <view class="dt">{{lang.user_nickname}}</view>
     <view class="dd">
      <input name="nickname" type="text" class="input" value="{{dou.user.nickname}}" placeholder="{{lang.user_nickname_placeholder}}" placeholder-class="placeholder" />
      <view class="cue" wx:if="{{wrong.nickname}}">{{wrong.nickname}}</view>
     </view>
    </view>
    <view class="dl" wx:if="{{language === 'en_us'}}">
     <view class="dt">{{lang.user_first_name}}
      <view class="i">*</view>
     </view>
     <view class="dd">
      <input name="first_name" type="text" class="input" value="{{dou.user.first_name}}" placeholder-class="placeholder" />
     </view>
    </view>
    <view class="dl" wx:if="{{language === 'en_us'}}">
     <view class="dt">{{lang.user_last_name}}
      <view class="i">*</view>
     </view>
     <view class="dd">
      <input name="last_name" type="text" class="input" value="{{dou.user.last_name}}" placeholder-class="placeholder" />
     </view>
    </view>
    <view class="dl">
     <view class="dt">{{lang.user_contact}}
      <view class="i" wx:if="{{language !== 'en_us'}}">*</view>
     </view>
     <view class="dd">
      <input name="contact" type="text" class="input" value="{{dou.user.contact}}" placeholder="{{lang.user_contact_placeholder}}" placeholder-class="placeholder" />
      <view class="cue" wx:if="{{wrong.contact}}">{{wrong.contact}}</view>
     </view>
    </view>
    <view class="dl">
     <view class="dt">{{lang.user_phone}}
      <view class="i">*</view>
     </view>
     <view class="dd">
      <input name="phone" type="text" class="input" value="{{dou.user.phone}}" placeholder="{{lang.user_mobile_placeholder}}" placeholder-class="placeholder" />
      <view class="cue" wx:if="{{wrong.phone}}">{{wrong.phone}}</view>
     </view>
    </view>
    <view class="dl">
     <view class="dt">{{lang.user_address}}</view>
     <view class="dd">
      <input name="address" type="text" class="input" value="{{dou.user.address}}" placeholder="{{lang.user_address_placeholder}}" placeholder-class="placeholder" />
      <view class="cue" wx:if="{{wrong.address}}">{{wrong.address}}</view>
     </view>
    </view>
    <view class="dl full" wx:if="{{features.area}}">
     <view class="dt">{{lang.user_contact_area}}</view>
     <view class="dd select-box">
      <picker class="select" mode="selector" range="{{country_list}}" range-key="name" bindchange="handleCountryChange" wx:if="{{multiple}}">
       <text wx:if="{{selectedCountry}}">{{selectedCountry}}</text>
       <text wx:else>{{lang.select}}</text>
      </picker>
      <picker class="select" mode="selector" range="{{province_list}}" range-key="name" bindchange="handleProvinceChange" wx:if="{{province_list.length > 0}}">
       <text wx:if="{{selectedProvince}}">{{selectedProvince}}</text>
       <text wx:else>{{lang.select}}</text>
      </picker>
      <picker class="select" mode="selector" range="{{city_list}}" range-key="name" bindchange="handleCityChange" wx:if="{{selectedProvince && city_list.length > 0}}">
       <text wx:if="{{selectedCity}}">{{selectedCity}}</text>
       <text wx:else>{{lang.select}}</text>
      </picker>
      <picker class="select" mode="selector" range="{{district_list}}" range-key="name" bindchange="handleDistrictChange" wx:if="{{selectedCity && district_list.length > 0}}">
       <text wx:if="{{selectedDistrict}}">{{selectedDistrict}}</text>
       <text wx:else>{{lang.select}}</text>
      </picker>
     </view>
    </view>
    <view class="dl">
     <view class="dt">{{lang.user_postcode}}</view>
     <view class="dd">
      <input name="postcode" type="text" class="input" value="{{dou.user.postcode}}" placeholder="{{lang.user_postcode_placeholder}}" placeholder-class="placeholder" />
      <view class="cue" wx:if="{{wrong.postcode}}">{{wrong.postcode}}</view>
     </view>
    </view>
    <view class="dl">
     <view class="dt">{{lang.user_sex}}</view>
     <view class="dd">
      <radio-group class="radio-group" bindchange="radioSex">
       <label class="radio" wx:for="{{dou.user.sex_list}}" wx:key="sex">
        <radio value="{{item.value}}" checked="{{item.checked}}"/>
        {{item.lang}} </label>
      </radio-group>
      <input type="text" name="sex" value="{{sex}}" hidden="true" />
     </view>
    </view>
    <view class="dl" wx:if="{{dou.user.avatar}}">
     <view class="dt">{{lang.user_avatar}}
      <view class="i">*</view>
     </view>
     <view class="dd">
      <view class="inputFile">
       <view class="imgShow">
        <image class="img" src="{{avatarTemp}}" wx:if="{{avatarTemp}}" />
        <image class="img" src="{{dou.user.avatar}}" wx:else />
       </view>
       <button class="imgBtn" bindtap="uploadAvatar">{{lang.user_avatar_upload}}</button>
      </view>
     </view>
    </view>
    <view class="action">
     <button class="btn" formType="submit">{{lang.btn_submit}}</button>
    </view>
   </form>
  </view>
 </view>
</view>
