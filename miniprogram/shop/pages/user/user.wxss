/* -- user -- 会员中心（头部支持自定义背景图 + 区块化白底列表） */
.user-bg {
  background: #f5f5f5;
}

/* -- 吸顶态：导航栏内的迷你头像 + 名称（滚动后淡入，点击进编辑资料） -- */
.nav-profile {
  display: flex;
  align-items: center;
  gap: 8px;
  /* 预留右侧胶囊按钮区域，窄屏下不与之重叠 */
  max-width: 200px;
  min-width: 0;
}
.nav-avatar {
  width: 28px;
  height: 28px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background-color: rgba(255, 255, 255, 0.22);
  border: 1px solid rgba(255, 255, 255, 0.6);
}
.nav-avatar image {
  display: block;
  width: 100%;
  height: 100%;
}
.nav-avatar text {
  font-size: 16px;
  line-height: 1;
  color: rgba(255, 255, 255, 0.9);
}
.nav-name {
  font-size: 14px;
  font-weight: 600;
  color: #ffffff;
  max-width: 130px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* -- 头部：自定义背景图或主题色底 + 方头像 + 会员号/等级 + 编辑按钮 -- */
.user-head {
  /* 用 background-color 而非 background 简写，否则会重置内联的 background-image */
  background-color: var(--color-primary);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  /* 未配背景图时的常规内边距；配图时 wxml 会内联 margin-top/-padding-top 把图顶到状态栏上方（沉浸式），
     仅覆盖 padding-top，左右下三边仍用这里约定 */
  padding: 8px 16px 24px;
}
.user-profile {
  display: flex;
  align-items: center;
  gap: 14px;
  padding-top: 4px;
}
.user-avatar {
  width: 76px;
  height: 76px;
  background-color: rgba(255, 255, 255, 0.22);
  border: 3px solid #ffffff;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.user-avatar image {
  display: block;
  width: 100%;
  height: 100%;
}
.user-avatar text {
  font-size: 34px;
  line-height: 1;
  color: rgba(255, 255, 255, 0.9);
}
.user-info {
  flex: 1;
  min-width: 0;
  height: 76px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8px;
}
.user-info-row {
  line-height: 1.1;
}
.user-info-label {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 3px;
}
.user-info-val {
  font-size: 13.5px;
  color: #ffffff;
  font-weight: 500;
  letter-spacing: 0.3px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-edit {
  width: 36px;
  height: 36px;
  margin-left: auto;
  align-self: flex-start;
  margin-top: 2px;
  border: 1px solid rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: #ffffff;
}

/* 未登录态：整块可点击进入登录 */
.user-guest {
  display: flex;
  align-items: center;
  gap: 14px;
  padding-top: 4px;
}
.user-guest .user-avatar {
  background-color: rgba(255, 255, 255, 0.05);
}
.user-guest-name {
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
  line-height: 1.3;
}
.user-guest-action {
  align-self: flex-start;
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 14px;
  padding: 4px 14px;
  font-size: 12px;
}

/* -- 资产统计：积分 / 优惠券 / 收藏夹 -- */
.user-assets {
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 18px 0;
}
.user-asset {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}
.user-asset + .user-asset {
  border-left: 1px solid #f0f0f0;
}
.user-asset-icon {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #f7f8fa;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.user-asset-icon text {
  font-size: 19px;
  line-height: 1;
  color: #666666;
}
.user-asset-text {
  min-width: 0;
}
.user-asset-text .num {
  font-size: 18px;
  font-weight: 500;
  color: #333333;
  line-height: 1.1;
}
.user-asset-text .name {
  margin-top: 2px;
  font-size: 11px;
  color: #999999;
}

/* -- 浅灰分割间距 -- */
.user-gap {
  height: 10px;
  background: #f5f5f5;
}

/* -- 区块标题 -- */
.user-block-head {
  font-size: 15px;
  font-weight: 600;
  color: #333333;
  margin-bottom: 18px;
}
.user-block-head.plain {
  padding: 16px 16px 0;
  margin-bottom: 0;
}

/* -- 我的订单 -- */
.user-orders {
  background: #ffffff;
  padding: 16px;
}
.user-order-grid {
  display: flex;
}
.user-order-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.user-order-icon {
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.user-order-icon text {
  font-size: 24px;
  line-height: 1;
  color: #222222;
}
.user-order-name {
  font-size: 11px;
  color: #333333;
  text-align: center;
}

/* -- 广告横幅：整张图片（images/ad_user_center.jpg） -- */
.user-banner {
  background: #ffffff;
  padding: 12px 16px;
}
.user-banner-img {
  display: block;
  width: 100%;
}

/* -- 纵向菜单列表 -- */
.user-panel {
  background: #ffffff;
}
.user-row {
  display: flex;
  align-items: center;
  min-height: 56px;
  padding: 0 16px;
  border-bottom: 1px solid #f0f0f0;
}
.user-row:last-child {
  border-bottom: none;
}
.user-row-icon {
  width: 22px;
  margin-right: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.user-row-icon text {
  font-size: 20px;
  line-height: 1;
  color: #333333;
}
.user-row-name {
  flex: 1;
  min-width: 0;
  font-size: 15px;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-row-arrow {
  margin-left: 8px;
  font-size: 14px;
  color: #cccccc;
}

/* -- 分销推广 -- */
.promotion {
  padding: 20px 15px;
  text-align: center;
  background: #ffffff;
}
.promotion .h2 {
  font-size: 16px;
  margin-top: 20px;
  margin-bottom: 5px;
}
.promotion .h2:first-child {
  margin-top: 0;
}
.promotion .link {
  color: #555;
}
.promotion .link text {
  display: block;
  color: #999;
}
.promotion .qrcode image {
  width: 200px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}
.promotion .qrcode text {
  display: block;
  color: #999;
}
